<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>CSKH Voice</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sử dụng micro để gọi và nhận cuộc gọi chăm sóc khách hàng.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>splashIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>VoiceAccountID</key>
	<string>$(VOICE_ACCOUNT_ID)</string>
	<key>VoiceAppID</key>
	<string>$(VOICE_APP_ID)</string>
	<key>VoiceEnterpriseBackendURL</key>
	<string>$(VOICE_ENTERPRISE_BACKEND_URL)</string>
	<key>VoiceBackendURL</key>
	<string>$(VOICE_BACKEND_URL)</string>
	<key>VoiceHotline</key>
	<string>$(VOICE_HOTLINE)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.business</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Thư viện cuộc gọi tích hợp có hỗ trợ camera cho cuộc gọi video. Bản demo này chỉ thực hiện cuộc gọi thoại và không yêu cầu truy cập camera.</string>
</dict>
</plist>
